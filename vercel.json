{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/follow-up-cron", "schedule": "0 3 * * *" },
    { "path": "/api/follow-up-automation", "schedule": "15 3 * * *" },
    { "path": "/api/payment-escalation-alert", "schedule": "30 3 * * *" }
  ]
}
