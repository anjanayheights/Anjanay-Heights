{
  "rewrites": [
    {
      "source": "/property/:id",
      "destination": "/api/index?route=seo-html&kind=property&id=:id"
    },
    {
      "source": "/locations/:slug",
      "destination": "/api/index?route=seo-html&kind=location&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=sitemap"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads-direct"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/follow-up-cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/follow-up-automation",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/payment-escalation-alert",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/instagram-auto-post",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/facebook-auto-post",
      "schedule": "30 3 * * *"
    }
  ]
}